# Activate with SPRING_PROFILES_ACTIVE=organization as well as APP_MODE=organization.
# Store real values in an approved secret manager; do not commit them.
SPRING_PROFILES_ACTIVE=organization
APP_MODE=organization
DEMO_DATA_ENABLED=false
OIDC_ISSUER=https://identity.example.com/oauth2/default
MINIMUM_COHORT_SIZE=5
SPRING_DATASOURCE_URL=jdbc:postgresql://database.internal:5432/engineering_intelligence
SPRING_DATASOURCE_USERNAME=engineering_intelligence_app
SPRING_DATASOURCE_PASSWORD=replace-through-secret-manager
GITHUB_WEBHOOK_SECRET=replace-through-secret-manager-with-at-least-32-characters
